    "preview": "vite preview",
    "check": "npm run typecheck && npm run test && npm run build:only"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.0",
    "vite": "^8.2.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
