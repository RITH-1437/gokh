{
  "name": "gokh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
